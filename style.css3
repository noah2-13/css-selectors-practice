/* Center the whole artwork on the page */
body {
  margin: 0;
  padding: 0;
  background: #ffffff;
  font-family: Arial, sans-serif;
}

.container {
  width: 600px;
  margin: 60px auto; /* centers horizontally */
}

/* Big yellow face box */
#face {
  background: #f2ff00; /* bright yellow */
  width: 380px;
  height: 420px;
  margin: 0 auto;
  padding: 30px;
  box-sizing: border-box;
}

/* Eyes row container */
.eyes {
  width: 100%;
  height: 140px;
  margin-bottom: 40px;
}

/* Each eye (white square) */
.eye {
  background: #ffffff;
  width: 140px;
  height: 120px;
  display: inline-block;
  margin-right: 30px;
  position: relative;
}

.eye:last-child {
  margin-right: 0;
}

/* Pupil (black square inside the eye) */
.pupil {
  background: #000000;
  width: 45px;
  height: 45px;
  position: absolute;
  top: 25px;
  left: 25px;
}

/* Mouth (big black rectangle) */
.mouth {
  background: #000000;
  width: 100%;
  height: 220px;
  position: relative;
  padding-top: 20px;
  box-sizing: border-box;
}

/* Teeth row */
.teeth {
  width: 100%;
  text-align: center;
  margin-bottom: 40px;
}

/* Each tooth (small white square) */
.tooth {
  background: #ffffff;
  width: 18px;
  height: 18px;
  display: inline-block;
  margin: 0 6px;
}

/* Tongue container */
.tongue {
  width: 160px;
  height: 90px;
  margin: 0 auto;
}

/* Two red blocks = tongue with a gap */
.tongue-left,
.tongue-right {
  background: #ff0000;
  width: 70px;
  height: 90px;
  display: inline-block;
}

.tongue-left {
  margin-right: 15px;
}
